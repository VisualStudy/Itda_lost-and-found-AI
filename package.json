{
  "name": "itda",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000 --local",
    "db:migrate:local": "wrangler d1 migrations apply itda-production --local",
    "db:seed:local": "wrangler d1 execute itda-production --local --file=./seed.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.2"
  }
}
